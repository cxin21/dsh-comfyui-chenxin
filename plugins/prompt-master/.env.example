# Prompt Master — 环境变量配置（与 src 全量 process.env 读取同步，2026-09-17 审计 F5）
# 注意：本插件为 DSH 原生插件，LLM 凭证走 DSH host 注入（peerDependencies）；
# 下列变量仅 PM_*/ANIMA_*/H3_* 为本插件自身读取项。

# ── 嵌入运行时（tag 向量语义检索，dialect/anima-vector.ts）──
# 嵌入模型：默认 Xenova/bge-base-en-v1.5（768 维，英文单语）；必须与建库脚本
# build_tag_vector.py 的 MODEL 同模型同维度，错配触发 VectorDimensionMismatchError fail-fast
# PM_EMBED_MODEL=Xenova/bge-base-en-v1.5
# e5 系旧别名（PM_EMBED_MODEL 未设时生效，仅 e5 模型使用）
# PM_E5_MODEL=Xenova/e5-small-v2
# 嵌入提供方：缺省本地 ONNX（零网络）；=api 时走 OpenAI 兼容 /embeddings（需配下面三项）
# PM_EMBED_PROVIDER=api
# PM_EMBED_API_BASE=https://your-endpoint/v1
# PM_EMBED_API_KEY=<YOUR_API_KEY>
# PM_EMBED_API_MODEL=your-embedding-model
# 量化 dtype：bge 系 fp32 / e5 系 q8（缺省随模型族自动选择）
# PM_EMBED_DTYPE=fp32

# ── 语义检索阈值（dialect/anima-vector.ts + retrieval-pack.ts）──
# KNN 命中分数下限（1-cos 距离），缺省 0.55
# PM_SEMANTIC_THRESHOLD=0.55
# 检索包质量门标定（spec §12.3）：semantic 命中分数下限（缺省 0.62）/ 非canonical 命中频次下限（缺省 100）
# PM_VECTOR_MIN_SCORE=0.62
# PM_VECTOR_MIN_USAGE=100

# ── 成文管线（compositing）──
# 子代理超时毫秒数（缺省见 intent/subagent-provider.ts DEFAULT_SUBAGENT_TIMEOUT_MS）
# PM_SUBAGENT_TIMEOUT_MS=600000
# 关闭 nl_tag_overlap 的 bge 向量检查（=off 时仅词面 + overlap_vector_unavailable advisory）
# PM_VECTOR_OVERLAP=on

# ── 资源路径覆盖（缺省从 preset 布局推导，通常无需设置）──
# preset 根目录（缺省由 DSH_COMFYUI_PRESET_ROOT / dist 位置推导）
# DSH_COMFYUI_PRESET_ROOT=
# tag 目录库路径（catalog-build 产物）
# ANIMA_CATALOG_PATH=
# tag 向量库路径（build_tag_vector.py 产物）
# ANIMA_VECTOR_PATH=
# 关系 overlay 库路径（catalog_relations 读写）
# ANIMA_OVERLAY_PATH=
# H3 tokenizer 目录（audit CJK 感知分词）
# H3_TOKENIZER_DIR=
# HuggingFace 模型缓存镜像（嵌入模型下载阻断环境）
# HF_ENDPOINT=https://hf-mirror.com
