# Prompt Master MCP Server — 环境变量配置

# 默认供应商 API Key（至少配置一个）
DEEPSEEK_API_KEY=sk-

# 可选供应商
OPENAI_API_KEY=
SILICONFLOW_API_KEY=

# 默认供应商和模型（可不配，用代码默认值）
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat

# 数据库路径（默认 ~/.prompt-master-mcp/data.db）
DB_PATH=

# 日志级别: debug | info | warn | error
LOG_LEVEL=info